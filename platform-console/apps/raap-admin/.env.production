# 生产环境配置

VITE_APP_TITLE=MAGA Console
VITE_APP_NAMESPACE=maga-console
VITE_APP_STORE_SECURE_KEY=maga-console-secure-key-change-in-production
VITE_BASE=/

# 接口地址 - 使用相对路径，通过 nginx 代理
VITE_GLOB_API_URL=/api

# 代理目标地址 (APISIX Gateway)
VITE_PROXY_TARGET=http://10.101.40.8:80

VITE_COMPRESS=gzip
VITE_PWA=false
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_ARCHIVER=true
VITE_APP_ENV=production
